{
  "name": "Samawa-Language",
  "publisher": "Rzfan03",
  "displayName": "Samawa-Language",
  "description": "Syntax highlighting and snippets for Samawa Language (.sl)",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samawa-Language/samawa-language"
  },
  "icon": "./icon-extension.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "icon": {
          "dark": "./icon-language.png",
          "light": "./icon-language.png"
        },
        "id": "samalang",
        "aliases": [
          "Samawa Language",
          "samalang"
        ],
        "extensions": [
          ".sl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "samalang",
        "scopeName": "source.sl",
        "path": "./syntaxes/samalang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "samalang",
        "path": "./snippets/samalang.code-snippets.json"
      }
    ]
  }
}
