{
  "scopeName": "source.sl",
  "name": "SamawaLang",
  "patterns": [
    {
      "name": "comment.line.number-sign.samawa",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.samawa",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.single.samawa",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "constant.numeric.samawa",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "constant.language.boolean.samawa",
      "match": "\\b(tutu|siong)\\b"
    },
    {
      "name": "constant.language.nil.samawa",
      "match": "\\b(nda_isi)\\b"
    },
    {
      "name": "keyword.control.samawa",
      "match": "\\b(lamen|tres|jure_mo|lamen_no|lamen_no_kebali|selama|boat|untuk|sampe|untu|ulang|jangka_mo)\\b"
    },
    {
      "name": "keyword.declaration.samawa",
      "match": "\\b(ada|fungsi|semalik)\\b"
    },
    {
      "name": "keyword.operator.logical.samawa",
      "match": "\\b(dan|atau|no)\\b"
    },
    {
      "name": "keyword.other.samawa",
      "match": "\\b(lalo|kenang)\\b"
    },
    {
      "name": "support.function.samawa",
      "match": "\\b(tulis)\\b"
    },
    {
      "name": "keyword.operator.arithmetic.samawa",
      "match": "(\\+|-|\\*|/|%|\\.\\.|\\^)"
    },
    {
      "name": "keyword.operator.comparison.samawa",
      "match": "(==|~=|<=|>=|<|>|=(?!=))"
    }
  ]
}
